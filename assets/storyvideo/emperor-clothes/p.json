{"text": "There was once an Emperor who loved new clothes more than anything. Two tricksters said, 'We can make magic cloth. Foolish people cannot see it!' The ministers saw nothing on the loom, but they said, 'How beautiful!' The Emperor could not see the clothes either, but he did not want to look foolish. He walked through the town in his 'new clothes', and everyone pretended to admire them. Then a little boy shouted, 'But he hasn't got anything on!' And everyone started to laugh.", "words": [[0.38, 0.49], [0.49, 0.65], [0.65, 0.96], [0.96, 1.11], [1.11, 1.76], [1.76, 1.96], [1.96, 2.34], [2.34, 2.58], [2.58, 3.15], [3.15, 3.34], [3.34, 3.5], [3.5, 4.16], [5.51, 5.71], [5.71, 6.22], [6.22, 6.59], [6.69, 6.81], [6.81, 6.96], [6.96, 7.19], [7.19, 7.56], [7.56, 8.06], [8.15, 8.56], [8.56, 8.94], [8.94, 9.32], [9.32, 9.6], [9.6, 9.93], [11.26, 11.35], [11.35, 11.91], [11.91, 12.14], [12.14, 12.54], [12.54, 12.64], [12.64, 12.73], [12.73, 13.08], [13.13, 13.28], [13.28, 13.5], [13.5, 13.9], [14.08, 14.28], [14.28, 15.1], [16.43, 16.56], [16.56, 17.0], [17.0, 17.17], [17.17, 17.41], [17.41, 17.61], [17.61, 17.73], [17.73, 18.23], [18.23, 18.73], [18.82, 18.96], [18.96, 19.07], [19.07, 19.23], [19.23, 19.43], [19.43, 19.63], [19.63, 19.73], [19.73, 19.98], [19.98, 20.68], [22.01, 22.13], [22.13, 22.41], [22.41, 22.63], [22.63, 22.77], [22.77, 23.21], [23.21, 23.33], [23.33, 23.56], [23.63, 23.87], [23.87, 24.68], [24.86, 25.02], [25.02, 25.51], [25.51, 26.05], [26.05, 26.2], [26.2, 26.73], [26.73, 27.11], [28.44, 28.55], [28.55, 28.6], [28.6, 28.88], [28.88, 29.24], [29.24, 29.89], [30.01, 30.12], [30.12, 30.22], [30.22, 30.51], [30.51, 30.71], [30.71, 31.18], [31.18, 31.64], [31.74, 31.89], [31.89, 32.33], [32.33, 32.78], [32.78, 32.91], [32.91, 33.49]], "scenes": [0.0, 5.11, 10.88, 16.05, 21.63, 28.06], "tag": "kokoro:bm_daniel"}