{"text": "In a London club, calm Mr Fogg made a bet: 'I can travel around the world in eighty days.' That same evening, he and his servant Passepartout ran to catch the train. They crossed the ocean on a big steamship at sunset. In India, there was no train, so they rode an elephant through the forest! In America, their train crossed high bridges over snowy mountains. At the very last minute, Mr Fogg walked into the club. He won the bet!", "words": [[0.48, 0.54], [0.58, 0.61], [0.68, 0.98], [1.04, 1.36], [1.52, 1.76], [1.84, 2.12], [2.2, 2.44], [2.52, 2.68], [2.72, 2.75], [2.78, 3.04], [3.1, 3.58], [3.62, 3.74], [3.8, 4.1], [4.16, 4.44], [4.46, 4.54], [4.58, 4.84], [4.9, 4.98], [5.1, 5.34], [5.42, 6.14], [7.38, 7.56], [7.64, 7.9], [7.98, 8.32], [8.58, 8.62], [8.7, 8.78], [8.82, 8.92], [8.98, 9.34], [9.38, 9.96], [10.12, 10.32], [10.4, 10.46], [10.52, 10.78], [10.84, 10.92], [11.0, 11.42], [12.94, 13.04], [13.1, 13.36], [13.38, 13.48], [13.58, 13.96], [14.12, 14.2], [14.22, 14.25], [14.34, 14.52], [14.58, 15.1], [15.14, 15.24], [15.32, 15.9], [17.4, 17.48], [17.58, 17.9], [18.08, 18.2], [18.22, 18.32], [18.4, 18.48], [18.66, 19.08], [19.38, 19.44], [19.52, 19.64], [19.72, 19.96], [19.98, 20.06], [20.16, 20.56], [20.62, 20.8], [20.82, 20.88], [20.96, 21.52], [23.0, 23.08], [23.12, 23.56], [23.84, 23.96], [24.0, 24.3], [24.4, 24.68], [24.74, 24.98], [25.04, 25.44], [25.56, 25.72], [25.8, 26.12], [26.2, 26.86], [28.34, 28.42], [28.46, 28.52], [28.56, 28.8], [28.9, 29.22], [29.3, 29.6], [29.76, 30.02], [30.08, 30.34], [30.42, 30.66], [30.7, 30.84], [30.88, 30.94], [30.98, 31.3], [31.66, 31.7], [31.78, 31.92], [31.96, 32.02], [32.06, 32.567]], "scenes": [0.0, 6.93, 12.48, 16.93, 22.53, 27.88], "tag": "kokoro:bm_daniel", "fx": "pb1", "aligned": "ctc1", "clamped": 1}