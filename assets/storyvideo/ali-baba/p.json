{"text": "One day, Ali Baba, a poor woodcutter, hid behind a rock and watched forty thieves. Their leader shouted, 'Open, Sesame!' and the rock opened like a door! When they left, Ali Baba went inside. The cave was full of gold and jewels! He took a little gold and went home happily on his donkey. But the thieves came to find him. Clever Morgiana noticed the big oil jars in the yard. Morgiana saved the family, and everyone celebrated her cleverness at a big feast.", "words": [[0.54, 0.68], [0.72, 0.94], [1.24, 1.48], [1.58, 1.94], [2.38, 2.41], [2.5, 2.7], [2.78, 3.28], [3.76, 3.92], [3.96, 4.36], [4.38, 4.41], [4.52, 4.78], [5.0, 5.08], [5.14, 5.44], [5.54, 5.88], [6.02, 6.6], [8.08, 8.22], [8.26, 8.5], [8.6, 9.08], [9.36, 9.82], [10.02, 10.56], [11.02, 11.1], [11.12, 11.2], [11.26, 11.46], [11.62, 11.96], [12.0, 12.2], [12.22, 12.25], [12.38, 12.72], [14.28, 14.38], [14.42, 14.54], [14.64, 15.0], [15.36, 15.58], [15.66, 15.98], [16.12, 16.3], [16.34, 17.02], [17.48, 17.56], [17.62, 18.04], [18.08, 18.22], [18.34, 18.54], [18.6, 18.68], [18.8, 19.22], [19.32, 19.44], [19.52, 20.02], [21.52, 21.58], [21.66, 21.8], [21.84, 21.87], [21.92, 22.14], [22.24, 22.72], [23.2, 23.3], [23.32, 23.48], [23.56, 23.8], [23.94, 24.36], [24.64, 24.72], [24.78, 24.9], [24.98, 25.36], [26.98, 27.1], [27.12, 27.2], [27.32, 27.8], [27.9, 28.14], [28.18, 28.24], [28.32, 28.66], [28.7, 28.84], [29.42, 29.7], [29.76, 30.38], [30.64, 31.16], [31.3, 31.4], [31.46, 31.64], [31.78, 32.0], [32.14, 32.56], [32.66, 32.74], [32.76, 32.84], [32.9, 33.36], [34.84, 35.52], [35.74, 36.12], [36.14, 36.22], [36.28, 36.7], [37.22, 37.34], [37.44, 37.94], [38.1, 38.78], [38.84, 38.94], [39.04, 39.6], [39.94, 40.02], [40.06, 40.09], [40.22, 40.44], [40.6, 41.201]], "scenes": [0.0, 7.63, 13.83, 21.06, 26.56, 34.36], "tag": "kokoro:bm_george", "fx": "pb1", "aligned": "ctc1", "clamped": 1}