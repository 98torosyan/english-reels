{"text": "Don Quixote read so many books about brave knights that he decided to become one. He put on some old armour, and his friend Sancho Panza looked at him in surprise. Together they rode out across the golden plains of Spain to find adventures. Suddenly, Don Quixote saw giants on a hill! 'Those are windmills!' cried Sancho. But Don Quixote attacked, and a windmill threw him high into the air. In the evening, by the fire, Sancho laughed, and Don Quixote smiled. He was still a proud knight.", "words": [[0.11, 0.39], [0.4, 0.99], [1.01, 1.24], [1.26, 1.52], [1.54, 1.84], [1.86, 2.21], [2.23, 2.56], [2.58, 2.93], [2.95, 3.31], [3.33, 3.46], [3.48, 3.61], [3.62, 4.2], [4.21, 4.29], [4.3, 4.68], [4.7, 5.12], [6.18, 6.36], [6.37, 6.61], [6.62, 6.77], [6.78, 7.06], [7.08, 7.34], [7.36, 7.69], [7.88, 8.0], [8.02, 8.22], [8.24, 8.59], [8.61, 9.06], [9.08, 9.5], [9.52, 9.8], [9.81, 9.91], [9.93, 10.09], [10.11, 10.21], [10.22, 11.02], [12.08, 12.48], [12.49, 12.64], [12.65, 12.99], [13.01, 13.26], [13.27, 13.64], [13.65, 13.76], [13.77, 14.26], [14.27, 14.71], [14.73, 14.83], [14.84, 15.26], [15.27, 15.39], [15.4, 15.8], [15.81, 16.59], [17.65, 18.25], [18.53, 18.8], [18.81, 19.38], [19.4, 19.62], [19.63, 20.16], [20.18, 20.33], [20.34, 20.38], [20.4, 20.9], [21.94, 22.29], [22.3, 22.41], [22.42, 23.11], [23.35, 23.76], [23.78, 24.42], [25.48, 25.67], [25.68, 25.92], [25.93, 26.46], [26.48, 27.01], [27.18, 27.29], [27.3, 27.36], [27.38, 27.85], [27.86, 28.13], [28.14, 28.33], [28.35, 28.66], [28.67, 28.99], [29.01, 29.18], [29.2, 29.49], [30.55, 30.7], [30.71, 30.83], [30.84, 31.31], [31.58, 31.73], [31.74, 31.86], [31.87, 32.39], [32.71, 33.17], [33.18, 33.68], [34.05, 34.2], [34.21, 34.45], [34.46, 35.03], [35.05, 35.74], [36.78, 36.98], [37.0, 37.15], [37.16, 37.47], [37.48, 37.56], [37.57, 37.98], [38.0, 38.48]], "scenes": [0.0, 6.07, 11.97, 17.54, 25.37, 30.44], "tag": "en-GB-ThomasNeural"}