{"text": "On a windy autumn afternoon, an old man dropped his wallet in the street. A young woman called Sarah saw it and picked it up. She ran after him and called, 'Excuse me, sir! Wait, please!' 'I think this is yours,' she said, and she gave him the wallet. The old man was so happy that he shook her hand and thanked her again and again. A week later, they met for tea and cake, and now they are good friends.", "words": [[0.48, 0.58], [0.62, 0.64], [0.76, 1.06], [1.26, 1.6], [1.66, 2.22], [2.48, 2.56], [2.68, 2.86], [2.94, 3.18], [3.34, 3.6], [3.64, 3.74], [3.82, 4.14], [4.2, 4.26], [4.3, 4.36], [4.46, 4.86], [6.44, 6.46], [6.56, 6.74], [6.8, 7.02], [7.1, 7.36], [7.46, 7.82], [7.9, 8.02], [8.16, 8.28], [8.34, 8.44], [8.5, 8.76], [8.8, 8.88], [8.96, 9.16], [10.7, 10.8], [10.88, 11.04], [11.12, 11.36], [11.42, 11.56], [11.6, 11.7], [11.74, 12.04], [12.08, 12.72], [12.78, 12.84], [13.02, 13.22], [13.52, 13.76], [13.88, 14.62], [14.64, 16.1], [16.18, 16.4], [16.46, 16.62], [16.66, 16.78], [16.9, 17.4], [17.56, 17.64], [17.76, 18.02], [18.1, 18.2], [18.24, 18.32], [18.4, 18.62], [18.64, 18.74], [18.76, 18.84], [18.92, 19.32], [20.84, 20.92], [21.04, 21.2], [21.28, 21.48], [21.56, 21.68], [21.78, 21.88], [22.08, 22.36], [22.5, 22.62], [22.66, 22.7], [22.82, 23.02], [23.08, 23.18], [23.26, 23.62], [23.8, 23.9], [24.0, 24.3], [24.34, 24.4], [24.44, 24.76], [24.88, 24.98], [25.02, 25.4], [26.96, 26.98], [27.06, 27.24], [27.34, 27.68], [27.8, 27.92], [27.96, 28.12], [28.18, 28.3], [28.38, 28.6], [28.66, 28.78], [28.82, 29.2], [29.36, 29.44], [29.52, 29.7], [29.74, 29.86], [29.9, 30.0], [30.04, 30.2], [30.28, 31.98]], "scenes": [0.0, 5.97, 10.24, 15.52, 20.39, 26.49], "tag": "kokoro:bf_alice", "fx": "pb1", "aligned": "ctc1"}