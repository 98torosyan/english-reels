{"text": "Dr Watson came back to rainy London after the war. He needed a cheap place to live. A friend took him to a laboratory, where a tall young man was doing an experiment. The man shook his hand and said, 'You have been in Afghanistan, I perceive.' Watson was amazed! The man was Sherlock Holmes. Together they rented rooms at 221B Baker Street. In the evenings, Holmes played the violin while Watson read by the fire. Soon they had their first mystery. Holmes studied the footprints with his magnifying glass.", "words": [[0.64, 0.96], [1.02, 1.44], [1.58, 1.82], [1.86, 2.08], [2.14, 2.2], [2.28, 2.54], [2.64, 3.0], [3.22, 3.48], [3.52, 3.6], [3.66, 3.92], [4.62, 4.66], [4.76, 5.04], [5.1, 5.13], [5.26, 5.54], [5.66, 6.04], [6.08, 6.16], [6.24, 6.54], [8.1, 8.13], [8.22, 8.54], [8.66, 8.84], [8.88, 8.98], [9.08, 9.16], [9.26, 9.29], [9.36, 10.04], [10.56, 10.68], [10.72, 10.75], [10.84, 11.14], [11.24, 11.46], [11.54, 11.86], [11.98, 12.1], [12.18, 12.46], [12.5, 12.56], [12.6, 13.32], [14.9, 14.98], [15.02, 15.26], [15.42, 15.6], [15.64, 15.74], [15.8, 16.1], [16.16, 16.26], [16.3, 16.54], [16.6, 17.1], [17.14, 17.26], [17.3, 17.48], [17.52, 17.62], [17.7, 18.66], [18.86, 18.89], [18.92, 20.1], [20.14, 20.56], [20.66, 20.78], [20.84, 21.46], [22.96, 23.04], [23.08, 23.4], [23.52, 23.66], [23.78, 24.26], [24.36, 24.8], [25.44, 25.82], [26.04, 26.14], [26.2, 26.52], [26.62, 27.04], [27.1, 27.18], [28.48, 28.51], [28.8, 29.14], [29.18, 29.48], [31.08, 31.16], [31.18, 31.26], [31.38, 31.92], [32.38, 32.72], [32.8, 33.04], [33.06, 33.12], [33.16, 33.68], [33.92, 34.1], [34.14, 34.52], [34.72, 34.98], [35.08, 35.22], [35.24, 35.32], [35.42, 35.82], [37.42, 37.68], [37.76, 37.86], [37.92, 38.04], [38.08, 38.22], [38.34, 38.7], [38.76, 39.16], [39.9, 40.3], [40.4, 40.72], [40.76, 40.82], [40.92, 41.42], [41.64, 41.76], [41.78, 41.88], [42.0, 42.84], [42.9, 43.441]], "scenes": [0.0, 7.51, 14.3, 22.36, 30.46, 36.77], "tag": "kokoro:bm_lewis", "fx": "pb1", "aligned": "ctc1", 