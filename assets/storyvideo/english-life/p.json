{"text": "Two years ago, I started to learn English. I studied every evening after work. On the bus, I listened to English lessons and repeated the words. One day, I helped two tourists in a café. I was nervous, but they understood me! Then I had a job interview in English, and I spoke with confidence. A few months later, I arrived in a new country for my new job. Now I work in an international team. English really changed my life!", "words": [[0.26, 0.48], [0.56, 0.82], [0.86, 1.04], [1.86, 1.89], [1.96, 2.46], [2.52, 2.6], [2.66, 2.92], [3.08, 3.54], [4.86, 4.89], [4.98, 5.4], [5.56, 5.82], [6.0, 6.42], [6.62, 6.92], [7.0, 7.36], [8.46, 8.56], [8.62, 8.7], [8.78, 9.02], [9.82, 9.85], [9.92, 10.28], [10.32, 10.38], [10.52, 10.86], [10.94, 11.42], [11.56, 11.66], [11.72, 12.22], [12.26, 12.34], [12.42, 12.9], [14.06, 14.22], [14.28, 14.54], [15.28, 15.31], [15.38, 15.7], [15.8, 15.98], [16.06, 16.64], [16.7, 16.78], [16.82, 16.85], [16.92, 17.28], [18.7, 18.73], [18.8, 18.94], [19.02, 19.56], [19.94, 20.06], [20.1, 20.22], [20.32, 20.84], [20.9, 20.98], [22.14, 22.32], [22.5, 22.53], [22.62, 22.8], [22.84, 22.87], [22.96, 23.22], [23.32, 23.76], [23.86, 23.92], [24.06, 24.56], [25.08, 25.2], [25.3, 25.33], [25.4, 25.78], [25.84, 25.96], [26.04, 26.76], [27.78, 27.81], [27.9, 28.1], [28.18, 28.5], [28.58, 28.96], [29.86, 29.89], [29.94, 30.44], [30.48, 30.56], [30.6, 30.63], [30.74, 30.9], [31.0, 31.46], [31.62, 31.74], [31.78, 31.94], [32.02, 32.16], [32.26, 32.58], [33.72, 33.96], [34.16, 34.19], [34.28, 34.64], [34.72, 34.78], [34.84, 34.92], [35.04, 35.78], [35.86, 36.2], [37.42, 37.84], [37.96, 38.28], [38.42, 38.92], [39.0, 39.14], [39.22, 39.666]], "scenes": [0.0, 8.17, 13.68, 21.84, 27.5, 33.37], "tag": "en-GB-LibbyNeural", "fx": "pb1", "aligned": "ctc1", "clamped": 1}