{"text": "One rainy morning, Leo found a small wet dog outside his house. The dog was cold and hungry, so Leo gave it some warm milk and a soft towel. On its blue collar, there was a name: Biscuit. Leo wanted to help Biscuit go home, so he made posters and put them on every street in his town. The next day, an old woman knocked on the door. 'That's my Biscuit!' she cried happily. She thanked Leo with a big chocolate cake, and now they have tea together every Sunday.", "words": [[0.43, 0.65], [0.65, 0.95], [0.95, 1.53], [1.64, 1.95], [1.95, 2.21], [2.21, 2.29], [2.29, 2.65], [2.65, 2.89], [2.89, 3.25], [3.25, 3.69], [3.69, 3.85], [3.85, 4.4], [5.75, 5.85], [5.85, 6.11], [6.11, 6.29], [6.29, 6.69], [6.69, 6.8], [6.8, 7.58], [7.74, 7.95], [7.95, 8.25], [8.25, 8.44], [8.44, 8.55], [8.55, 8.76], [8.76, 9.05], [9.05, 9.37], [9.37, 9.49], [9.49, 9.59], [9.59, 9.87], [9.87, 10.41], [11.76, 11.9], [11.9, 12.08], [12.08, 12.33], [12.33, 12.66], [12.7, 12.8], [12.8, 12.92], [12.92, 13.01], [13.01, 13.56], [13.67, 14.47], [15.87, 16.2], [16.2, 16.52], [16.52, 16.65], [16.65, 16.92], [16.92, 17.3], [17.3, 17.5], [17.5, 18.25], [18.38, 18.53], [18.53, 18.63], [18.63, 18.86], [18.86, 19.47], [19.47, 19.59], [19.59, 19.78], [19.78, 19.91], [19.91, 20.08], [20.08, 20.42], [20.42, 20.77], [20.77, 20.86], [20.86, 21.02], [21.02, 21.56], [22.91, 22.98], [22.98, 23.29], [23.29, 23.54], [23.57, 23.66], [23.66, 23.94], [23.94, 24.24], [24.24, 24.47], [24.47, 24.57], [24.57, 24.66], [24.66, 25.41], [25.61, 25.89], [25.89, 26.09], [26.09, 26.78], [26.91, 27.03], [27.03, 27.36], [27.36, 27.98], [29.36, 29.48], [29.48, 29.83], [29.83, 30.13], [30.13, 30.27], [30.27, 30.33], [30.33, 30.58], [30.58, 31.12], [31.12, 31.83], [31.93, 32.05], [32.05, 32.31], [32.31, 32.45], [32.45, 32.63], [32.63, 32.88], [32.88, 33.27], [33.27, 33.6], [33.6, 34.23]], "scenes": [0.0, 5.35, 11.36, 15.42, 22.51, 28.93], "tag": "kokoro:bf_emma"}