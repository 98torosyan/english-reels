{"text": "In an old sailor's sea chest, young Jim found a map of an island with hidden treasure. At the harbour, he met Long John Silver, a friendly cook with a wooden crutch and a green parrot. They sailed across the stormy sea on a big ship called the Hispaniola. One night, Jim hid in a barrel of apples and heard a terrible secret: the sailors were pirates! On the island, Jim ran through the jungle to warn his friends. At last, they found the treasure in a cave, a chest full of gold!", "words": [[0.1, 0.31], [0.32, 0.44], [0.45, 0.7], [0.72, 1.16], [1.17, 1.39], [1.41, 1.91], [2.22, 2.51], [2.53, 2.85], [2.86, 3.2], [3.22, 3.26], [3.28, 3.56], [3.57, 3.67], [3.69, 3.79], [3.81, 4.28], [4.29, 4.45], [4.47, 4.76], [4.78, 5.35], [6.4, 6.61], [6.62, 6.69], [6.71, 7.22], [7.37, 7.47], [7.49, 7.78], [7.8, 8.06], [8.08, 8.39], [8.4, 9.0], [9.22, 9.28], [9.3, 9.77], [9.78, 10.06], [10.08, 10.21], [10.22, 10.28], [10.3, 10.66], [10.68, 11.08], [11.09, 11.19], [11.21, 11.28], [11.3, 11.65], [11.66, 12.24], [13.29, 13.51], [13.53, 13.94], [13.95, 14.33], [14.35, 14.47], [14.48, 14.88], [14.89, 15.2], [15.22, 15.36], [15.38, 15.45], [15.47, 15.73], [15.75, 16.07], [16.08, 16.39], [16.41, 16.48], [16.5, 17.44], [18.49, 18.89], [18.9, 19.27], [19.45, 19.77], [19.78, 19.98], [19.99, 20.11], [20.12, 20.2], [20.21, 20.64], [20.65, 20.74], [20.75, 21.25], [21.27, 21.37], [21.39, 21.7], [21.71, 21.78], [21.8, 22.3], [22.31, 22.86], [23.12, 23.24], [23.25, 23.78], [23.8, 23.96], [23.98, 24.83], [25.88, 26.16], [26.17, 26.29], [26.31, 26.89], [27.16, 27.51], [27.53, 27.82], [27.84, 28.1], [28.12, 28.23], [28.25, 28.72], [28.73, 28.85], [28.87, 29.22], [29.23, 29.44], [29.45, 30.14], [31.19, 31.45], [31.47, 31.95], [32.1, 32.25], [32.26, 32.63], [32.65, 32.73], [32.75, 33.2], [33.22, 33.32], [33.34, 33.41], [33.43, 33.95], [34.18, 34.23], [34.25, 34.69], [34.7, 34.9], [34.91, 35.04], [35.06, 35.7]], "scenes": [0.0, 6.3, 13.19, 18.39, 25.78, 31.09], "tag": "en-GB-RyanNeural"}