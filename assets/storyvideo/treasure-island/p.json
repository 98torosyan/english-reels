{"text": "In an old sailor's sea chest, young Jim found a map of an island with hidden treasure. At the harbour, he met Long John Silver, a friendly cook with a wooden crutch and a green parrot. They sailed across the stormy sea on a big ship called the Hispaniola. One night, Jim hid in a barrel of apples and heard a terrible secret: the sailors were pirates! On the island, Jim ran through the jungle to warn his friends. At last, they found the treasure in a cave, a chest full of gold!", "words": [[0.32, 0.4], [0.44, 0.52], [0.6, 0.8], [0.9, 1.28], [1.32, 1.48], [1.6, 1.98], [2.38, 2.58], [2.68, 2.9], [3.02, 3.3], [3.36, 3.38], [3.46, 3.6], [3.7, 3.78], [3.82, 3.9], [4.1, 4.38], [4.44, 4.58], [4.6, 4.86], [4.94, 5.36], [6.62, 6.72], [6.74, 6.82], [6.9, 7.28], [7.5, 7.56], [7.66, 7.86], [7.94, 8.14], [8.22, 8.44], [8.62, 9.04], [9.34, 9.36], [9.48, 9.86], [9.94, 10.16], [10.2, 10.32], [10.36, 10.38], [10.48, 10.74], [10.84, 11.16], [11.22, 11.32], [11.34, 11.36], [11.44, 11.74], [11.8, 12.24], [13.5, 13.62], [13.74, 14.06], [14.1, 14.42], [14.48, 14.56], [14.62, 14.96], [15.08, 15.28], [15.38, 15.46], [15.52, 15.54], [15.66, 15.84], [15.94, 16.12], [16.22, 16.5], [16.54, 16.6], [16.68, 17.42], [18.82, 18.96], [19.04, 19.36], [19.64, 19.86], [19.94, 20.1], [20.14, 20.22], [20.26, 20.28], [20.38, 20.72], [20.76, 20.84], [20.94, 21.34], [21.4, 21.5], [21.58, 21.8], [21.86, 21.88], [21.96, 22.4], [22.5, 22.92], [23.24, 23.32], [23.46, 23.88], [23.96, 24.1], [24.14, 24.82], [26.16, 26.26], [26.3, 26.38], [26.64, 26.96], [27.34, 27.56], [27.68, 27.9], [27.98, 28.22], [28.26, 28.34], [28.42, 28.8], [28.86, 28.96], [29.06, 29.32], [29.4, 29.54], [29.62, 30.14], [31.44, 31.54], [31.66, 32.02], [32.22, 32.36], [32.44, 32.72], [32.76, 32.82], [32.9, 33.32], [33.36, 33.44], [33.48, 33.5], [33.6, 34.08], [34.28, 34.3], [34.44, 34.76], [34.84, 35.0], [35.04, 35.1], [35.22, 36.72]], "scenes": [0.0, 6.3, 13.19, 18.39, 25.78, 31.09], "tag": "en-GB-RyanNeural", "fx": "pb1", "aligned":