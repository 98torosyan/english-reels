{"text": "Before New Year, Anna and her mum went to the winter market in the city centre. There were lights everywhere, and music played in the square. They bought a small wooden star for their tree. Then Anna saw an old man selling hot chestnuts. 'Two bags, please,' she said. The chestnuts were warm in her cold hands. On the way home, it started to snow, and Anna laughed.", "words": [[0.14, 0.46], [0.58, 0.72], [0.82, 1.04], [1.6, 1.8], [1.98, 2.12], [2.16, 2.26], [2.32, 2.52], [2.6, 2.76], [2.8, 2.86], [2.9, 2.98], [3.04, 3.34], [3.38, 3.8], [3.9, 3.98], [4.02, 4.1], [4.16, 4.38], [4.48, 4.82], [5.8, 5.94], [5.96, 6.1], [6.16, 6.5], [6.6, 7.12], [7.52, 7.64], [7.76, 8.22], [8.32, 8.7], [8.76, 8.82], [8.86, 8.94], [9.0, 9.4], [10.36, 10.5], [10.6, 10.88], [10.94, 10.97], [11.06, 11.38], [11.48, 11.7], [11.82, 12.14], [12.24, 12.36], [12.38, 12.54], [12.62, 12.9], [13.98, 14.26], [14.46, 14.66], [14.78, 14.94], [15.0, 15.08], [15.24, 15.48], [15.56, 15.86], [16.02, 16.36], [16.48, 16.7], [16.88, 17.5], [18.46, 18.68], [18.74, 19.12], [19.16, 19.64], [19.72, 19.8], [19.9, 20.16], [21.06, 21.14], [21.22, 21.76], [21.8, 21.96], [22.02, 22.32], [22.38, 22.44], [22.5, 22.6], [22.68, 23.0], [23.08, 23.52], [24.5, 24.6], [24.62, 24.7], [24.76, 24.92], [25.06, 25.38], [25.7, 25.78], [25.86, 26.28], [26.32, 26.38], [26.48, 26.8], [27.22, 27.34], [27.44, 27.62], [27.74, 28.295]], "tag": "chatterbox:sonia", "pace": "v2-slow", "fx": "pb1", "aligned": "ctc2", "clamped": 1}