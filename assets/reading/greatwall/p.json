{"text": "The Great Wall of China is one of the most famous buildings in the world. In fact, it is not one wall but many walls, built over more than two thousand years. All the parts together are about twenty-one thousand kilometres long. Soldiers used the towers to watch for enemies, and they sent messages with smoke and fire. Many people believe that you can see the wall from space, but this is a myth. It is too narrow to see with your eyes.", "words": [[0.46, 0.54], [0.6, 0.86], [0.98, 1.24], [1.28, 1.34], [1.44, 1.84], [2.18, 2.26], [2.36, 2.44], [2.46, 2.5], [2.52, 2.6], [2.64, 2.84], [2.94, 3.36], [3.46, 4.02], [4.08, 4.14], [4.16, 4.24], [4.32, 4.78], [6.12, 6.2], [6.28, 6.6], [6.7, 6.78], [6.82, 6.92], [7.0, 7.14], [7.3, 7.44], [7.54, 7.84], [7.92, 8.02], [8.08, 8.28], [8.4, 8.9], [9.26, 9.46], [9.54, 9.72], [9.78, 9.94], [9.96, 10.08], [10.18, 10.36], [10.46, 10.92], [10.98, 11.4], [12.82, 12.94], [12.98, 13.06], [13.1, 13.42], [13.48, 13.88], [14.18, 14.28], [14.3, 14.54], [14.62, 15.14], [15.2, 15.64], [15.7, 16.28], [16.38, 16.7], [18.1, 18.64], [18.76, 18.96], [18.98, 19.06], [19.12, 19.56], [19.62, 19.68], [19.74, 20.0], [20.04, 20.12], [20.2, 20.66], [21.06, 21.16], [21.18, 21.28], [21.36, 21.56], [21.66, 22.26], [22.32, 22.46], [22.56, 22.94], [23.0, 23.1], [23.2, 23.66], [25.06, 25.28], [25.38, 25.68], [25.76, 26.26], [26.32, 26.44], [26.5, 26.58], [26.62, 26.74], [26.86, 27.0], [27.04, 27.12], [27.2, 27.44], [27.5, 27.66], [27.76, 28.22], [28.52, 28.64], [28.68, 28.88], [29.0, 29.1], [29.14, 29.16], [29.3, 29.58], [30.98, 31.06], [31.1, 31.2], [31.3, 31.46], [31.56, 31.94], [32.1, 32.16], [32.26, 32.42], [32.48, 32.6], [32.64, 32.76], [32.9, 34.3]], "tag": "kokoro:bm_daniel", "pace": "v2-slow", "fx": "pb1", "aligned": "ctc1"}