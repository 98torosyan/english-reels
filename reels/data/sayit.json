      "lines": [
        {"k": "intro", "lang": "hy", "text": "Այս երեք բառը շատերն են սխալ արտասանում։ Ստուգեք ինքներդ ձեզ։"},
        {"k": "w1a", "lang": "hy", "text": "Առաջինը՝ ոչ թե «վեգետաբլ», այլ՝"},
        {"k": "w1", "lang": "en", "text": "Vegetable."},
        {"k": "w1b", "lang": "hy", "text": "Երեք վանկ, ոչ թե չորս։"},
        {"k": "w2a", "lang": "hy", "text": "Երկրորդը՝ ոչ թե «կոմֆորտաբլ», այլ՝"},
        {"k": "w2", "lang": "en", "text": "Comfortable."},
        {"k": "w2b", "lang": "hy", "text": "Մեջտեղի «օր»-ը կուլ է գնում։"},
        {"k": "w3a", "lang": "hy", "text": "Եվ երրորդը՝ ոչ թե «վեդնեսդեյ», այլ՝"},
        {"k": "w3", "lang": "en", "text": "Wednesday."},
        {"k": "w3b", "lang": "hy", "text": "Առաջին «դ»-ն չի կարդացվում։"},
        {"k": "outro", "lang": "hy", "text": "Ո՞ր մեկն էիք սխալ ասում։ Գրեք մեկնաբանություններում։"}
